<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="740.0" prefWidth="560.0"
            style="-fx-background: #F4F6F9; -fx-background-color: #F4F6F9; -fx-padding: 0;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.monederovirtualjfx.viewController.MenuViewController">
    <content>
        <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: #F4F6F9;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <!-- Encabezado -->
                <VBox alignment="CENTER" spacing="5.0">
                    <Label style="-fx-text-fill: #1E293B;" text="Monedero Virtual">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                    <Label fx:id="lblBienvenido" style="-fx-text-fill: #64748B;" text="Bienvenido" wrapText="true">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Resumen de puntos y rango -->
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Puntos acumulados" />
                            <Label fx:id="lblPuntos" style="-fx-text-fill: #1E293B; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Rango" />
                            <Label fx:id="lblRango" style="-fx-text-fill: #1E293B; -fx-font-size: 20px; -fx-font-weight: bold;" text="BRONCE" />
                        </VBox>
                    </children>
                </HBox>

                <!-- Monederos del usuario -->
                <VBox spacing="8.0" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                    <children>
                        <Label style="-fx-text-fill: #334155; -fx-font-weight: bold;" text="Mis monederos" />
                        <Label fx:id="lblMonederos" style="-fx-text-fill: #475569; -fx-font-size: 13px;" text="Cargando..." wrapText="true" />
                    </children>
                </VBox>

                <!-- Título de opciones -->
                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 14px;" text="¿Qué deseas hacer?" />

                <!-- Botones de opciones: 2 columnas x 5 filas -->
                <GridPane hgap="12.0" vgap="12.0" maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                    </columnConstraints>
                    <children>

                        <!-- Operaciones -->
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308" onAction="#abrirDeposito" prefHeight="42.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Depositar" />
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308" onAction="#abrirRetiro" prefHeight="42.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Retirar" />
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" onAction="#abrirTransferencia" prefHeight="42.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Transferir" />
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" onAction="#abrirProgramarTransaccion" prefHeight="42.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Programar transacción" />

                        <!-- Consultas -->
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" onAction="#abrirHistorial" prefHeight="42.0" style="-fx-background-color: white; -fx-text-fill: #1E293B; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Historial" />
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" onAction="#abrirPuntosRango" prefHeight="42.0" style="-fx-background-color: white; -fx-text-fill: #1E293B; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Puntos y rango" />
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" onAction="#abrirReporteGastos" prefHeight="42.0" style="-fx-background-color: white; -fx-text-fill: #1E293B; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Reporte de gastos" />
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" onAction="#abrirCanjeBeneficios" prefHeight="42.0" style="-fx-background-color: white; -fx-text-fill: #1E293B; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Canjear beneficios" />

                        <!-- Notificaciones y servicios -->
                        <Button GridPane.columnIndex="0" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308" onAction="#abrirNotificaciones" prefHeight="42.0" style="-fx-background-color: white; -fx-text-fill: #1E293B; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Notificaciones" />
                        <Button GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308" onAction="#ejecutarProgramadas" prefHeight="42.0" style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Ejecutar programadas" />

                    </children>
                </GridPane>

                <!-- Mensaje de estado -->
                <Label fx:id="lblMensajeMenu" style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="" wrapText="true" />

                <!-- Cerrar sesión -->
                <Button maxWidth="1.7976931348623157E308" onAction="#cerrarSesion" prefHeight="45.0" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Cerrar sesión" />

            </children>
        </VBox>
    </content>
</ScrollPane>