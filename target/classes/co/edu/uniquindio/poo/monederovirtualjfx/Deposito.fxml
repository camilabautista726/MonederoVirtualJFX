<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="680.0" prefWidth="480.0" spacing="14.0" style="-fx-background-color: #F4F6F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.monederovirtualjfx.viewController.DepositoViewController">
    <padding>
        <Insets bottom="28.0" left="35.0" right="35.0" top="28.0" />
    </padding>
    <children>
        <Label style="-fx-text-fill: #1E293B;" text="Depositar">
            <font><Font name="System Bold" size="22.0" /></font>
        </Label>
        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Agrega saldo a uno de tus monederos" wrapText="true" />

        <VBox maxWidth="1.7976931348623157E308" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
            <children>
                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold;" text="Monedero" />
                <ComboBox fx:id="cmbMonedero" maxWidth="1.7976931348623157E308" promptText="Seleccione un monedero" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold;" text="Monto" />
                <TextField fx:id="txtMonto" promptText="Ej. 50000" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #CBD5E1; -fx-border-radius: 8;" />

                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold;" text="Fecha" />
                <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;" />

                <CheckBox fx:id="chkProgramada" style="-fx-text-fill: #334155;" text="Programar esta transacción" />
                <ComboBox fx:id="cmbFrecuencia" maxWidth="1.7976931348623157E308" promptText="Frecuencia (solo si es programada)" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;" />
            </children>
        </VBox>

        <Label fx:id="lblMensaje" style="-fx-text-fill: #EF4444; -fx-font-size: 12px;" text="" wrapText="true" />

        <Button fx:id="btnDepositar" maxWidth="1.7976931348623157E308" onAction="#depositar" prefHeight="45.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Depositar" />
        <Button fx:id="btnVolver" maxWidth="1.7976931348623157E308" onAction="#volver" prefHeight="40.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Volver al menú" />
    </children>
</VBox>
