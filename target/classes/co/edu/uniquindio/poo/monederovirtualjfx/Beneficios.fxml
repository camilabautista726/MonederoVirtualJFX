<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="760.0" prefWidth="520.0"
            style="-fx-background: #F4F6F9; -fx-background-color: #F4F6F9; -fx-padding: 0;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.monederovirtualjfx.viewController.BeneficiosViewController">
    <content>
        <VBox alignment="CENTER" spacing="14.0" style="-fx-background-color: #F4F6F9;">
            <padding>
                <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
            </padding>
            <children>
                <Label style="-fx-text-fill: #1E293B;" text="Canjear beneficios">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Usa tus puntos acumulados" wrapText="true" />

                <VBox maxWidth="1.7976931348623157E308" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                    <children>
                        <Label style="-fx-text-fill: #334155; -fx-font-weight: bold;" text="Monedero (solo para el beneficio de 1000 puntos)" />
                        <ComboBox fx:id="cmbMonedero" maxWidth="1.7976931348623157E308" promptText="Seleccione un monedero" style="-fx-background-radius: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 8;" />
                    </children>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                    <children>
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold;" text="Beneficio 100 puntos" />
                        <Label style="-fx-text-fill: #475569; -fx-font-size: 12px;" text="10% de descuento en la comisión de la próxima transferencia" wrapText="true" />
                        <Button fx:id="btnCanjear100" maxWidth="1.7976931348623157E308" onAction="#canjear100" prefHeight="40.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Canjear por 100 puntos" />
                    </children>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                    <children>
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold;" text="Beneficio 500 puntos" />
                        <Label style="-fx-text-fill: #475569; -fx-font-size: 12px;" text="Un mes sin cargos por retiro" wrapText="true" />
                        <Button fx:id="btnCanjear500" maxWidth="1.7976931348623157E308" onAction="#canjear500" prefHeight="40.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Canjear por 500 puntos" />
                    </children>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                    <children>
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold;" text="Beneficio 1000 puntos" />
                        <Label style="-fx-text-fill: #475569; -fx-font-size: 12px;" text="Bono de 50 unidades de saldo en el monedero" wrapText="true" />
                        <Button fx:id="btnCanjear1000" maxWidth="1.7976931348623157E308" onAction="#canjear1000" prefHeight="40.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Canjear por 1000 puntos" />
                    </children>
                </VBox>

                <Label fx:id="lblMensaje" style="-fx-text-fill: #EF4444; -fx-font-size: 12px;" text="" wrapText="true" />

                <Button fx:id="btnVolver" maxWidth="1.7976931348623157E308" onAction="#volver" prefHeight="40.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Volver al menú" />
            </children>
        </VBox>
    </content>
</ScrollPane>

